# Defaults start a labelled lexical evidence preview without downloading models.
EMBEDDING_MODE=hash
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cpu
MODEL_BASE_URL=http://127.0.0.1:1234/v1
MODEL_ID=
MODEL_TIMEOUT=120
MAX_TOKENS=384
TEMPERATURE=0
# Optional token for a locally authenticated model server. Never commit .env.
MODEL_API_KEY=
